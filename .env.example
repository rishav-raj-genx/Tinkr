# ==============================================================================
# Tinkr Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit .env or real secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Speech-to-Text Providers
# ------------------------------------------------------------------------------
# Google AI Studio API key used for Gemma 4 (via OpenAI-compatible endpoint)
# Obtain from: https://aistudio.google.com/apikey
API_KEY=your_google_ai_studio_api_key_here

# Groq API key used for fast Whisper STT audio transcription
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform & OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# OAuth 2.0 Web Client credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret_here

# Redirect URI registered in Google Cloud Console OAuth consent
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ------------------------------------------------------------------------------
# 3. Google Workspace & Calendar Settings
# ------------------------------------------------------------------------------
# Google Calendar ID to check availability, book meetings, and set reminders
# Use 'primary' or the specific calendar email address
HOST_CALENDAR_ID=primary

# Primary email address associated with the account
HOST_EMAIL=your_email@gmail.com

# ------------------------------------------------------------------------------
# 4. Third-Party Integrations
# ------------------------------------------------------------------------------
# OpenWeatherMap API key for current weather and forecasts
# Obtain from: https://home.openweathermap.org/api_keys
WEATHER_API_KEY=your_openweathermap_api_key_here

# ------------------------------------------------------------------------------
# 5. Application Server & Security Configuration
# ------------------------------------------------------------------------------
# Host and port for Flask/Gunicorn server (default: 0.0.0.0:5000)
# PORT=5000
# HOST=0.0.0.0
# FLASK_ENV=development

# Allowed origin for CORS validation on Flask API endpoints
FRONTEND_URL=http://localhost:8000

# Secret key for Flask session signing and CSRF protection
SECRET_KEY=generate_a_secure_random_string_here

# Owner access key for authenticating owner sessions
# Setting this unlocks live Google Workspace (Gmail, Calendar, Tasks) via owner login,
# while visitors use safe Portfolio Demo Sandbox mode. Leave empty to disable owner login.
# OWNER_ACCESS_KEY=your_secure_owner_passphrase_here

# Optional path overrides (defaults to repository root)
# DB_PATH=company_data.db
# TOKEN_PATH=token.json
